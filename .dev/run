#!/bin/sh
set -eu
dev_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_dir=$(CDPATH= cd -- "$dev_dir/.." && pwd)
case "${1:-}" in
  go) tool=go; work_dir=/workspace ;;
  bun) tool=bun; work_dir=/workspace/web; test -f "$project_dir/web/package.json" ;;
  *) echo 'Usage: .dev/run go <args> | bun <args>' >&2; exit 2 ;;
esac
shift
image=$(python3 - "$dev_dir/toolchains.lock.json" "$tool" "${DEV_IMAGE_SOURCE:-domestic}" <<'IMAGE'
import json,sys
lock=json.load(open(sys.argv[1]))
print(lock[sys.argv[2]][sys.argv[3]])
IMAGE
)
mkdir -p "$project_dir/.cache/dev/modules" "$project_dir/.cache/dev/go-build" "$project_dir/.cache/dev/bun" "$project_dir/.cache/dev/node_modules" "$project_dir/build/dev"
set -- docker run --rm --pull=never --platform linux/amd64 \
  --cpus=2 --memory=3g --memory-swap=3g \
  --user "$(id -u):$(id -g)" \
  --mount "type=bind,source=$project_dir,target=/workspace" \
  --mount "type=bind,source=$project_dir/.cache/dev,target=/cache" \
  --mount "type=bind,source=$project_dir/build/dev,target=/artifacts" \
  --workdir "$work_dir" \
  --env HOME=/tmp --env TMPDIR=/tmp \
  --env GOTOOLCHAIN=local --env GOWORK=off --env 'GOFLAGS=-p=2 -mod=readonly' \
  --env GOEXPERIMENT=greenteagc --env GOMAXPROCS=2 --env GOMEMLIMIT=2300MiB \
  --env GOCACHE=/cache/go-build --env GOMODCACHE=/cache/modules \
  --env "GOPROXY=${GOPROXY:-https://goproxy.cn,direct}" --env GOSUMDB=sum.golang.org \
  --env "CGO_ENABLED=${CGO_ENABLED:-0}" \
  --env BUN_INSTALL_CACHE_DIR=/cache/bun --env BUN_CONFIG_MAX_HTTP_REQUESTS=16 \
  --env "npm_config_registry=${NPM_REGISTRY:-https://registry.npmjs.org}" \
  --env NODE_OPTIONS=--max-old-space-size=2304 --env RAYON_NUM_THREADS=2 \
  --env "VITE_REACT_APP_VERSION=${CUSTOM_VERSION:-}" \
  --entrypoint "$tool" "$image" "$@"
# Only the frontend tool needs a separate node_modules mount.
if [ "$tool" = bun ]; then
  # Insert the mount immediately after docker run; retain each argument separately.
  shift 2
  set -- docker run --mount "type=bind,source=$project_dir/.cache/dev/node_modules,target=/workspace/web/node_modules" "$@"
fi
exec "$@"
